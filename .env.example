# Copie este arquivo para .env. Nenhuma API é obrigatória e não há segredos neste exemplo.
VAGASSCAN_DATABASE=data/vagasscan.db
# O banco fictício permanece separado e também pode apontar para um caminho temporário.
VAGASSCAN_DEMO_DATABASE=data/vagasscan_demo.db
VAGASSCAN_PROFILE=data/profile.json
VAGASSCAN_KEYWORDS=data/keywords.json
VAGASSCAN_LOG=logs/vagasscan.log

# Provedor HTTP genérico. Deixe JOB_API_URL vazio para desativá-lo. Prefira HTTPS.
# A URL deve ser fornecida pelo serviço escolhido e retornar JSON no formato documentado.
JOB_API_URL=
JOB_API_TOKEN=
JOB_API_TOKEN_HEADER=Authorization
JOB_API_REQUIRES_TOKEN=false
JOB_API_TIMEOUT=10
