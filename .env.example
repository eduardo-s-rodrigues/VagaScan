# Copie para .env e mantenha os campos secretos vazios até configurá-los.
VAGASSCAN_DATABASE=data/vagasscan.db
VAGASSCAN_DEMO_DATABASE=data/vagasscan_demo.db
VAGASSCAN_PUBLIC_DATABASE=data/vagasscan_public.db
VAGASSCAN_PROFILE=data/profile.json
VAGASSCAN_PUBLIC_PROFILE=data/profile_public.json
VAGASSCAN_KEYWORDS=data/keywords.json
VAGASSCAN_LOG=logs/vagasscan.log

# API oficial da Adzuna. Nunca publique app_id ou app_key.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=br
ADZUNA_RESULTS_PER_PAGE=20
ADZUNA_TIMEOUT=10
ADZUNA_CACHE_MINUTES=30
VAGASSCAN_MAX_EXTRA_PAGES_FOR_FILTER=2
VAGASSCAN_SAVED_JOBS_LIMIT=200
VAGASSCAN_PUBLIC_SEARCH_COOLDOWN_SECONDS=15
VAGASSCAN_PUBLIC_SEARCH_LIMIT_PER_HOUR=30
VAGASSCAN_PUBLIC_ANALYSIS_LIMIT_PER_MINUTE=10
VAGASSCAN_ADMIN_SEARCH_LIMIT_PER_HOUR=100
VAGASSCAN_ADZUNA_GLOBAL_LIMIT_PER_MINUTE=10

# Provedor HTTP genérico opcional.
JOB_API_URL=
JOB_API_TOKEN=
JOB_API_TOKEN_HEADER=Authorization
JOB_API_REQUIRES_TOKEN=false
JOB_API_TIMEOUT=10

# Administrador único. Gere hash e segredo pelos comandos documentados.
VAGASSCAN_ADMIN_USERNAME=admin
VAGASSCAN_ADMIN_PASSWORD_HASH=
VAGASSCAN_SESSION_SECRET=
VAGASSCAN_PUBLIC_DEMO=true

# Organizador web opcional: o navegador nunca escolhe caminhos.
VAGASSCAN_ENABLE_FILE_ORGANIZER_WEB=false
VAGASSCAN_FILE_ORGANIZER_SOURCE=
VAGASSCAN_FILE_ORGANIZER_DESTINATION=

VAGASSCAN_HOST=127.0.0.1
VAGASSCAN_PORT=8000
VAGASSCAN_ENV=development
VAGASSCAN_BASE_URL=http://127.0.0.1:8000
VAGASSCAN_COOKIE_SECURE=false
